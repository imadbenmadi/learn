# The code is edited on Windows but compiled and run on Linux (the dev container).
# Store and check out every text file with LF, whatever core.autocrlf says on the host.
* text=auto eol=lf

# Explicit for the files that break with CRLF: the shebang line becomes "bash\r".
*.sh   text eol=lf
mvnw   text eol=lf

# Source files (already covered by the rule above; listed so the intent is obvious).
*.java       text eol=lf
*.xml        text eol=lf
*.properties text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.sql        text eol=lf
*.md         text eol=lf
Dockerfile   text eol=lf

# Windows-only scripts keep CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary files are never converted.
*.jar  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
